# Copy this file to .env.local and change what you need. Never commit .env.local.

# Where the Vite dev server forwards /api requests (your Spring Boot app).
VITE_PROXY_TARGET=http://localhost:8080

# Leave empty in development (the proxy handles it).
# For a separately hosted production build, set the full API URL, e.g. https://api.example.com
VITE_API_URL=

# Photo upload and face search endpoints are not in the backend yet.
# true  = the app uses built-in demo photos so you can show the full flow.
# false = the app calls the real endpoints listed in the README.
VITE_MOCK_PHOTOS=true
